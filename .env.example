# ========== macOS 签名与公证（可选；本地未签名构建可留空） ==========
# 用于 Tauri macOS 打包签名与 Apple 公证，若无证书请保持注释
# APPLE_CERTIFICATE=          # Base64 编码的 .p12 证书内容 / Base64 后的证书
# APPLE_CERTIFICATE_PASSWORD= # .p12 证书密码 / 证书导入密码
# APPLE_ID=                   # Apple 开发者账号邮箱 / 用于公证的 Apple ID
# APPLE_PASSWORD=              # App 专用密码（app-specific password）/ 公证专用密码
# APPLE_TEAM_ID=              # Apple Team ID / 团队标识

# ========== 前端环境变量（VITE_ 前缀，构建时注入） ==========
# 本地服务端口，默认 6123（需与 src-tauri 配置保持一致）
# VITE_PORT=6123
# 本地服务地址，用于前端请求转发
# VITE_API_BASE_URL=http://127.0.0.1:6123
# 调试开关，开启后前端打印详细日志
# VITE_DEBUG=false

# ========== Tauri 环境变量（TAURI_ 前缀，构建时注入） ==========
# Tauri 签名私钥（用于自动更新签名验证）
# TAURI_SIGNING_PRIVATE_KEY=
# Tauri 签名私钥密码
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# 自定义 Tauri 配置路径（如需覆盖默认 tauri.conf.json）
# TAURI_CONFIG=
